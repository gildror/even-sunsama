# Copy to .env.development.local (git-ignored, dev server only - never reaches `vite build`).
# mock = built-in fixture tasks, sunsama = real account via the official Sunsama MCP server
VITE_PROVIDER=mock
# Output of `pnpm auth --label sim`. Only used when storage holds no sign-in yet.
VITE_SUNSAMA_SEED_BUNDLE=
